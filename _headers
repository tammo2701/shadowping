# Cloudflare Pages Headers
# Wird von Cloudflare Pages beim Deploy ausgewertet (nicht vom Vite-Dev-Server).

# Vite-Dateinamen enthalten einen Content-Hash und können nach dem ersten
# Abruf langfristig im Browser- und CDN-Cache bleiben.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Die HTML-Shell und der Service Worker müssen regelmäßig aktualisiert werden,
# damit neue App-Versionen und der Update-Hinweis zeitnah erkannt werden.
/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

# Sicherheits-Header für alle Routen (Best-Practices-Prüfungen von Lighthouse).
# HSTS: zwingt Browser auf HTTPS. XFO: kein Einbetten (Clickjacking).
# COOP: isoliert den Ursprung; allow-popups ist für OAuth-Redirects sicher
# (kein Popup-Auth, nur signInWithOAuth mit redirectTo).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Referrer-Policy: strict-origin-when-cross-origin

# APK: beim Aufruf direkt herunterladen statt anzeigen.
# X-Robots-Tag noindex = zusätzliches Signal, dass Google die Datei nicht indexiert.
/shadowping.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="Shadowping.apk"
  Cache-Control: public, max-age=604800
  X-Robots-Tag: noindex

# Banner-Bilder: als normale Bilder ausliefern + cachen
/ShadowPing_Feature_1024x500.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800

/ShadowPing_Feature_3840x2160.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800
